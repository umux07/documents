# Copy this file to .env and replace the placeholders before starting the app.
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# MySQL/MariaDB. Create the "louf" database once with database/schema.sql.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=louf

# Choose openai or deepseek. Keep API keys on the server; never put them in client/.
AI_PROVIDER=openai
OPENAI_API_KEY=replace_with_a_new_openai_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
DEEPSEEK_API_KEY=replace_with_a_new_deepseek_key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions

# Set a unique strong password to create/update the bootstrap administrator.
# Leave blank to skip administrator bootstrapping.
ADMIN_PASSWORD=
